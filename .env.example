# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/coloc_lyon?schema=public"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generer_avec_openssl_rand_base64_32"

# OAuth (optionnel)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Carte (OpenStreetMap ne nécessite pas de clé ; pour Google Maps :)
NEXT_PUBLIC_MAPS_PROVIDER="osm" # "osm" ou "google"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Geocoding (Nominatim public a des limites de taux ; en prod utiliser un provider payant)
GEOCODING_PROVIDER="nominatim"

# Notifications email (ex: Resend, SMTP)
EMAIL_FROM="alertes@coloc-lyon.fr"
RESEND_API_KEY=""

# Sources d'annonces — voir src/scrapers/README.md pour le détail légal de chaque source
JINKA_API_KEY=""
LOCSERVICE_PARTNER_KEY=""
